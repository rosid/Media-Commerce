# ==============================================================================
# MediaFlow ERP — VPS Environment Configuration Template
# ==============================================================================

# Server Runtime Environment (production on VPS, development for local dev)
NODE_ENV="production"

# Port on which the Express server listens (default: 3000)
PORT=3000

# Base URL of your deployed application (e.g. https://pos.digdayamedia.com)
APP_URL="https://pos.digdayamedia.com"

# JWT Secret Key for token encryption & session verification
# CRITICAL: Generate a strong random key on your VPS with: openssl rand -hex 32
JWT_SECRET="ganti-dengan-kunci-rahasia-yang-sangat-kuat-dan-acak-di-vps"

# ==============================================================================
# Database Configuration (Pilih MariaDB/MySQL atau SQLite)
# ==============================================================================
# DB_TYPE: 'mariadb' (untuk VPS xCloud) atau 'sqlite' (untuk pengujian lokal)
DB_TYPE="mariadb"

# Kredensial MariaDB / MySQL di VPS (xCloud / Ubuntu LEMP):
# Default host di VPS biasanya 127.0.0.1 atau localhost
DB_HOST="127.0.0.1"
DB_PORT=3306
DB_USER="pos_digdayamedi"
DB_PASSWORD="password_database_anda"
DB_NAME="pos_digdayamedi_db"

# SQLite persistent database file path (digunakan jika DB_TYPE="sqlite" atau saat fallback):
DB_PATH="./mediaflow.db"

# Optional: Google Gemini API Key for smart drafting / AI features
# GEMINI_API_KEY=""
