# ==============================================================================
# MediaFlow ERP — VPS Environment Configuration Template
# ==============================================================================

# Server Runtime Environment (production on VPS, development for local dev)
NODE_ENV="production"

# Port on which the Express server listens (default: 3000)
PORT=3000

# Base URL of your deployed application (e.g. https://erp.domainanda.com)
# Used for asset URLs, webhooks, and self-referential links
APP_URL="https://erp.domainanda.com"

# JWT Secret Key for token encryption & session verification
# CRITICAL: Generate a strong random key on your VPS with: openssl rand -hex 32
JWT_SECRET="ganti-dengan-kunci-rahasia-yang-sangat-kuat-dan-acak-di-vps"

# SQLite persistent database file path
# Defaults to ./mediaflow.db in project root
DB_PATH="./mediaflow.db"

# Optional: Google Gemini API Key for smart drafting / AI features
# GEMINI_API_KEY=""
